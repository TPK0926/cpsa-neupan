<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="barn_robot">
    <static>false</static>
    <!-- Base link: 0.5m x 0.4m rectangle for BARN (matches Jackal footprint) -->
    <link name="base_link">
      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.158</ixx><iyy>0.221</iyy><izz>0.354</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry>
          <box><size>0.5 0.4 0.4</size></box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <geometry>
          <box><size>0.5 0.4 0.4</size></box>
        </geometry>
        <material>
          <ambient>0.2 0.6 0.2 1</ambient>
          <diffuse>0.2 0.6 0.2 1</diffuse>
        </material>
      </visual>
      <!-- 2D LiDAR sensor: 270° FOV (Hokuyo-like), 10m range, 360 beams -->
      <sensor name="lidar2d" type="ray">
        <pose>0.15 0 0.25 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-2.3561945</min_angle>
              <max_angle>2.3561945</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/robot</namespace>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>base_link</frame_name>
        </plugin>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
      </sensor>
    </link>
    <!-- Differential drive plugin -->
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/robot</namespace>
      </ros>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.4</wheel_separation>
      <wheel_diameter>0.12</wheel_diameter>
      <max_wheel_torque>10</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
    <!-- Left wheel -->
    <link name="left_wheel_link">
      <pose relative_to="base_link">0 0.25 -0.14 1.5707963 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.06</radius><length>0.04</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.06</radius><length>0.04</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel_link</child>
      <axis><xyz>0 1 0</xyz></axis>
      <limit><lower>-1e16</lower><upper>1e16</upper></limit>
    </joint>
    <!-- Right wheel -->
    <link name="right_wheel_link">
      <pose relative_to="base_link">0 -0.25 -0.14 1.5707963 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.06</radius><length>0.04</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.06</radius><length>0.04</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
    </link>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel_link</child>
      <axis><xyz>0 1 0</xyz></axis>
      <limit><lower>-1e16</lower><upper>1e16</upper></limit>
    </joint>
  </model>
</sdf>
