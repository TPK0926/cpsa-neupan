<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="tb3_slalom">
    <physics type="ode"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Corridor: 2.5m wide (y=3.75 to y=6.25), 25m long -->
    <model name="top_wall"><static>true</static><pose>12.5 6.25 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>25 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>25 0.3 1</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual></link></model>
    <model name="bottom_wall"><static>true</static><pose>12.5 3.75 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>25 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>25 0.3 1</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual></link></model>

    <!-- 4 obstacles: 0.5m wide, staggered to create 0.55-0.70m gaps -->
    <!-- Obs1: right side, gap=0.55m to top wall -->
    <model name="obs1"><static>true</static><pose>6 5.75 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.4 1.0 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 1.0 1</size></box></geometry><material><ambient>0.9 0.4 0.3 1</ambient></material></visual></link></model>
    <!-- Obs2: left side, gap=0.55m to bottom wall -->
    <model name="obs2"><static>true</static><pose>11 4.25 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.4 1.0 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 1.0 1</size></box></geometry><material><ambient>0.9 0.4 0.3 1</ambient></material></visual></link></model>
    <!-- Obs3: right side, gap=0.55m -->
    <model name="obs3"><static>true</static><pose>16 5.75 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.4 1.0 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 1.0 1</size></box></geometry><material><ambient>0.9 0.4 0.3 1</ambient></material></visual></link></model>
    <!-- Obs4: left side, gap=0.55m -->
    <model name="obs4"><static>true</static><pose>21 4.25 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.4 1.0 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 1.0 1</size></box></geometry><material><ambient>0.9 0.4 0.3 1</ambient></material></visual></link></model>

    <include><uri>model://turtlebot3_burger</uri><name>turtlebot3</name><pose>0 5 0.01 0 0 0</pose></include>
  </world>
</sdf>
