<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="tb3_narrow">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Narrow passage: 1.5m wide, 20m long -->
    <!-- TB3 is 0.14m wide => ~0.68m clearance per side -->
    <model name="top_wall">
      <static>true</static>
      <pose>10 5.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20 0.3 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name="bottom_wall">
      <static>true</static>
      <pose>10 4.25 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20 0.3 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Pinch point: two blocks creating 0.8m gap at x=10 -->
    <model name="pinch_left">
      <static>true</static>
      <pose>10 4.65 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.5 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.5 1</size></box></geometry>
          <material><ambient>0.9 0.3 0.3 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name="pinch_right">
      <static>true</static>
      <pose>10 5.35 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.5 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.5 1</size></box></geometry>
          <material><ambient>0.9 0.3 0.3 1</ambient></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://turtlebot3_burger</uri>
      <name>turtlebot3</name>
      <pose>0 5 0.01 0 0 0</pose>
    </include>
  </world>
</sdf>
