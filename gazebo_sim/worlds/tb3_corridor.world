<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="tb3_corridor">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- === Narrow corridor with obstacles (2.5m wide, 25m long) === -->
    <!-- Top wall -->
    <model name="top_wall">
      <static>true</static>
      <pose>12.5 6.25 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>25 0.5 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>25 0.5 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>
    <!-- Bottom wall -->
    <model name="bottom_wall">
      <static>true</static>
      <pose>12.5 3.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>25 0.5 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>25 0.5 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 1: Left side, blocks half corridor, gap ~1.2m -->
    <model name="obs_1">
      <static>true</static>
      <pose>8 4.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.9 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.9 1</size></box></geometry>
          <material><ambient>0.9 0.4 0.3 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2: Right side, blocks half corridor, gap ~1.2m -->
    <model name="obs_2">
      <static>true</static>
      <pose>16 5.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.9 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.9 1</size></box></geometry>
          <material><ambient>0.9 0.4 0.3 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- TurtleBot3 Burger spawn at start position -->
    <include>
      <uri>model://turtlebot3_burger</uri>
      <name>turtlebot3</name>
      <pose>0 5 0.01 0 0 0</pose>
    </include>

  </world>
</sdf>
