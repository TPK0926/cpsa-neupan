<?xml version="1.0" ?>
<!-- Gazebo world matching IR-SIM Dyna_obs environment.
     World: 42m x 42m, 20 dynamic circular obstacles with RVO behavior.
     Start: (10, 42, pi/2), Goal: (40, 40, 0) in IR-SIM coords.
     Obstacles: circles r=0.4, 0.5, 1.0m, RVO wander behavior. -->
<sdf version="1.6">
  <world name="dyna_obs">
    <physics type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Boundary walls (42x42 area) -->
    <model name="wall_north"><static>true</static><pose>23.5 44.5 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>45 1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>45 1 1</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>23.5 2.5 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>45 1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>45 1 1</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>
    <model name="wall_east"><static>true</static><pose>44.5 23.5 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1 45 1</size></box></geometry></collision><visual name="v"><geometry><box><size>1 45 1</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>
    <model name="wall_west"><static>true</static><pose>2.5 23.5 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1 45 1</size></box></geometry></collision><visual name="v"><geometry><box><size>1 45 1</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual></link></model>

    <!-- 20 Dynamic obstacles (spawned via ROS2 node, initial positions here) -->
    <!-- Obstacle radii cycle: 0.5, 1.0, 1.0, 0.4 (matching IR-SIM templates) -->
    <model name="dyn_obs_0"><static>false</static><pose>15 20 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>0.5</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>0.5</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_1"><static>false</static><pose>20 30 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>1.0</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>1.0</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_2"><static>false</static><pose>25 25 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>1.0</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>1.0</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_3"><static>false</static><pose>30 15 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>0.4</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>0.4</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_4"><static>false</static><pose>18 35 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>0.5</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>0.5</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_5"><static>false</static><pose>22 18 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>1.0</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>1.0</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_6"><static>false</static><pose>28 22 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>1.0</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>1.0</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_7"><static>false</static><pose>35 28 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>0.4</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>0.4</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_8"><static>false</static><pose>32 32 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>0.5</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>0.5</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_9"><static>false</static><pose>15 28 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>1.0</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>1.0</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_10"><static>false</static><pose>38 20 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>1.0</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>1.0</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_11"><static>false</static><pose>20 38 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>0.4</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>0.4</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_12"><static>false</static><pose>25 12 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>0.5</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>0.5</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_13"><static>false</static><pose>12 25 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>1.0</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>1.0</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_14"><static>false</static><pose>33 38 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>1.0</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>1.0</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_15"><static>false</static><pose>40 15 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>0.4</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>0.4</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_16"><static>false</static><pose>28 35 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>0.5</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>0.5</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_17"><static>false</static><pose>16 33 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>1.0</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>1.0</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_18"><static>false</static><pose>36 12 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>1.0</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>1.0</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
    <model name="dyn_obs_19"><static>false</static><pose>30 40 0.5 0 0 0</pose><link name="link"><inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>0.4</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>0.4</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>

    <!-- Robot spawn: IR-SIM start [10, 42, pi/2] -->
    <include>
      <uri>model://diff_robot</uri>
      <name>diff_robot</name>
      <pose>10 42 0.25 0 0 1.5707963</pose>
    </include>
  </world>
</sdf>
