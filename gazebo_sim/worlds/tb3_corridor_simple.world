<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="tb3_corridor_simple">
    <physics type="ode"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- 3m wide, 12m long corridor. 5 obstacles staggered, 1.2-1.5m gaps -->
    <model name="top_wall"><static>true</static><pose>6.0 5.5 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>12.0 0.3 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.0 0.3 1.0</size></box></geometry></visual></link></model>
    <model name="bottom_wall"><static>true</static><pose>6.0 2.5 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>12.0 0.3 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.0 0.3 1.0</size></box></geometry></visual></link></model>

    <model name="obs1"><static>true</static><pose>2.5 3.2 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.4 0.8 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.8 1.0</size></box></geometry><material><ambient>0.9 0.4 0.3 1</ambient></material></visual></link></model>
    <model name="obs2"><static>true</static><pose>4.3 4.8 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.4 0.7 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.7 1.0</size></box></geometry><material><ambient>0.9 0.4 0.3 1</ambient></material></visual></link></model>
    <model name="obs3"><static>true</static><pose>6.0 3.3 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.4 0.8 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.8 1.0</size></box></geometry><material><ambient>0.9 0.4 0.3 1</ambient></material></visual></link></model>
    <model name="obs4"><static>true</static><pose>7.8 4.7 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.4 0.7 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.7 1.0</size></box></geometry><material><ambient>0.9 0.4 0.3 1</ambient></material></visual></link></model>
    <model name="obs5"><static>true</static><pose>9.5 3.4 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.4 0.8 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.8 1.0</size></box></geometry><material><ambient>0.9 0.4 0.3 1</ambient></material></visual></link></model>

    <include><uri>model://turtlebot3_burger</uri><name>turtlebot3</name>
      <pose>0.5 4.0 0.01 0 0 0</pose></include>
  </world>
</sdf>
